# Скопируйте в .env и при необходимости измените. Все переменные необязательны.

# Сервер моделей с OpenAI-совместимым API.
# Ollama на этой же машине:      http://localhost:11434/v1
# Ollama из docker compose:      http://ollama:11434/v1  (задаётся в compose автоматически)
# llama-server:                  http://localhost:8080/v1
# vLLM в Colab/Kaggle (ngrok):   https://<id>.ngrok-free.app/v1
# OpenRouter / Groq:             https://openrouter.ai/api/v1  (нужен IMAGEHUB_LLM_API_KEY)
IMAGEHUB_LLM_BASE_URL=http://localhost:11434/v1
IMAGEHUB_LLM_API_KEY=ollama
IMAGEHUB_LLM_MODEL=qwen3-vl:2b-instruct
IMAGEHUB_OCR_MODEL=glm-ocr
# Необязательно: эмбеддинги описаний через /v1/embeddings (пусто: локальная multilingual-e5-small)
IMAGEHUB_EMBED_MODEL=

IMAGEHUB_LOG_LEVEL=INFO
IMAGEHUB_LOG_JSON=true
